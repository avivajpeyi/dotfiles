" Vim for quick editing; VS Code is the primary Python IDE.
" No plugin manager or third-party Vim plugins required.
set nocompatible
syntax on
filetype plugin indent on

set number
set cursorline
set mouse=a
set scrolloff=5
set splitbelow
set splitright
set showcmd
set hidden
set wildmenu

set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4
set smartindent

set ignorecase
set smartcase
set incsearch
set hlsearch
set showmatch

set undofile
set undodir=~/.vim/undo//
