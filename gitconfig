[user]
    name = Avi Vajpeyi
    email = avi.vajpeyi@gmail.com

[core]
    editor = vim
    pager = delta

[init]
    defaultBranch = main

[fetch]
    prune = true

[push]
    default = simple
    autoSetupRemote = true

[pull]
    rebase = false

[alias]
    s = status --short --branch
    graph = log --graph --oneline --decorate --all
    pr = "!gh pr create --web"

[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

# Optional machine-specific overrides; never commit this local file.
[include]
    path = ~/.gitconfig.local
