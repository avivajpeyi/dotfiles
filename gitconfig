[user]
    name = Avi Vajpeyi
    email = avi.vajpeyi@gmail.com

[core]
    editor = vim
    pager = delta

[init]
    defaultBranch = main

[fetch]
    prune = true

[push]
    default = simple
    autoSetupRemote = true

[pull]
    rebase = false

[alias]
    s = status --short --branch
    graph = log --graph --pretty=format:'%C(bold blue)%h%Creset - %C(yellow)(%ar)%C(reset) %s %C(white)<%an>%Creset %C(reverse yellow)%d%Creset' --abbrev-commit
    gh = "!gh repo view --web"
    pr = "!gh pr create --web"

[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

# Override machine- or employer-specific settings here (never commit this file).
[include]
    path = ~/.gitconfig.local
