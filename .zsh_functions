# Create a directory and enter it.
mkcd() {
  if (( $# != 1 )); then
    print -u2 "Usage: mkcd <directory>"
    return 2
  fi
  mkdir -p -- "$1" && cd -- "$1"
}

# Unpack common archive formats.
extract() {
  if (( $# != 1 )) || [[ ! -f "$1" ]]; then
    print -u2 "Usage: extract <archive>"
    return 2
  fi
  case "$1" in
    *.tar.bz2|*.tbz2) tar xjf "$1" ;;
    *.tar.gz|*.tgz)   tar xzf "$1" ;;
    *.tar.xz)         tar xJf "$1" ;;
    *.tar)            tar xf "$1" ;;
    *.zip)            unzip "$1" ;;
    *.gz)             gunzip "$1" ;;
    *.7z)             7z x "$1" ;;
    *) print -u2 "Unsupported archive type: $1"; return 1 ;;
  esac
}

# Git branch summary plus working-tree status.
gss() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    print -u2 "Not inside a Git repository"
    return 1
  fi
  git branch -avv
  print
  git status --short --branch
}

# Tail a log with syntax highlighting when bat is installed.
ttail() {
  if (( $# != 1 )); then
    print -u2 "Usage: ttail <logfile>"
    return 2
  fi
  if command -v bat >/dev/null 2>&1; then
    tail -f "$1" | bat --paging=never --language=log
  else
    tail -f "$1"
  fi
}
