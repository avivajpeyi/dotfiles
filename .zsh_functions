# Only portable, actively useful helpers (no old machine-specific aliases).
mkcd() {
  if (( $# != 1 )); then
    print -u2 "Usage: mkcd <directory>"
    return 2
  fi
  mkdir -p -- "$1" && cd -- "$1"
}

gss() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    print -u2 "Not a Git repository"
    return 1
  }
  git branch -avv
  print
  git status --short --branch
}
